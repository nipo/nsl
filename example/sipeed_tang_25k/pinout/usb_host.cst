// USB-A port, host role: weak pull-downs on both lines stand in for
// the 15k host-side terminations; an attached low-speed device
// overrides D- through its 1.5k pull-up.
IO_LOC  "usb_p_io" L6;
IO_PORT "usb_p_io" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
IO_LOC  "usb_n_io" K6;
IO_PORT "usb_n_io" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
