# Digilent Pmod I2S2: seven clocks and data out of the board, and
# the serial data of the input converter back in.  The input pin
# takes no drive setting, which is what separates this from the
# plain double connector.
IO_LOC  "j4_io[5]" G10;
IO_PORT "j4_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "j4_io[1]" G11;
IO_PORT "j4_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "j4_io[6]" D10;
IO_PORT "j4_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "j4_io[2]" D11;
IO_PORT "j4_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "j4_io[7]" B10;
IO_PORT "j4_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "j4_io[3]" B11;
IO_PORT "j4_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
IO_LOC  "j4_io[8]" C10;
IO_PORT "j4_io[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "j4_io[4]" C11;
IO_PORT "j4_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 BANK_VCCIO=3.3;
