// Sipeed PMOD-TF-Card on J4.  The board holds the command and data
// lines with 470 kOhm only, so the pads provide the pull-ups a bus
// needs.
// DAT3
IO_LOC  "j4_io[1]" G11;
IO_PORT "j4_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// CMD
IO_LOC  "j4_io[2]" D11;
IO_PORT "j4_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// DAT0
IO_LOC  "j4_io[3]" B11;
IO_PORT "j4_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// CLK
IO_LOC  "j4_io[4]" C11;
IO_PORT "j4_io[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// DAT1
IO_LOC  "j4_io[5]" G10;
IO_PORT "j4_io[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// DAT2
IO_LOC  "j4_io[6]" D10;
IO_PORT "j4_io[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// Card detect, pulled up on the board
IO_LOC  "j4_io[7]" B10;
IO_PORT "j4_io[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
// Write protect, tied high on the board
IO_LOC  "j4_io[8]" C10;
IO_PORT "j4_io[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
