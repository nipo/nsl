# The wires a DVI sink needs beyond the Pmod's own header.
#
# Hot plug detect says a sink is there at all, and DDC is the I2C a
# source reads the sink's EDID over.  CEC is a separate file, since a
# DVI link does not use it.
#
# The DDC pins are ordinary bidirectional pins.  Open drain is what the
# driver does, by driving low or letting go, so asking the pad for it
# as well leaves the value it drives when letting go unstated -- and a
# pad that drives low whatever the logic says holds the bus down for
# good.  The bus is pulled up on the Pmod.

IO_LOC  "dvi_hpd_o" J11;
IO_PORT "dvi_hpd_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "dvi_ddc_sda_io" J10;
IO_PORT "dvi_ddc_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;

IO_LOC  "dvi_ddc_scl_io" F6;
IO_PORT "dvi_ddc_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;
