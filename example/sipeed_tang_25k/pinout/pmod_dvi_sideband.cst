# The four wires a DVI sink needs beyond the Pmod's own header.
#
# Hot plug detect says a sink is there at all, and DDC is the I2C a
# source reads the sink's EDID over.  CEC is placed for completeness;
# a DVI link does not use it.

IO_LOC  "dvi_hpd_o" J11;
IO_PORT "dvi_hpd_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "dvi_cec_io" F7;
IO_PORT "dvi_cec_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4;

IO_LOC  "dvi_ddc_sda_io" J10;
IO_PORT "dvi_ddc_sda_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 OPEN_DRAIN=ON;

IO_LOC  "dvi_ddc_scl_io" F6;
IO_PORT "dvi_ddc_scl_io" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=4 OPEN_DRAIN=ON;
