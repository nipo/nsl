NET "ram_cen"       LOC = "P114" | IOSTANDARD = LVCMOS25 | SLEW = FAST;  # Chip enable, active low, hardware pullup
NET "ram_bwbn"      LOC = "P115" | IOSTANDARD = LVCMOS25 | SLEW = FAST;
NET "ram_bwan"      LOC = "P116" | IOSTANDARD = LVCMOS25 | SLEW = FAST;
