# 12MHz oscillator input
# Named, and constrained by timespec rather than by the net period
# shorthand: ISE only derives requirements for what a DCM or a PLL
# makes out of a clock when the constraint carries a name.  With the
# shorthand every generated domain goes unanalysed, which is quiet and
# wrong.
NET "clk"          LOC =  "P55" | IOSTANDARD = LVCMOS33 | SLEW = FAST | BUFG = CLK | TNM_NET = "board_clk";
TIMESPEC TS_board_clk = PERIOD "board_clk" 83.33 ns HIGH 50%;
