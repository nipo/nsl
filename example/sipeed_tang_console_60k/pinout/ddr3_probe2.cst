# Probe wiring for the populated DDR3 site, at DDR3-800.
#
# The bank is at 1.5V and the part takes its own reference from the
# board divider, so plain LVCMOS15 carries both directions here.  Data
# pins are pulled down, which makes an undriven bus read as idle.
#
# Only the first site is fitted; the second one's lanes are left
# unconstrained.

IO_LOC  "ddr3_ck_p_o" L3;
IO_PORT "ddr3_ck_p_o" IO_TYPE=LVCMOS15 DRIVE=8;
IO_LOC  "ddr3_ck_n_o" K3;
IO_PORT "ddr3_ck_n_o" IO_TYPE=LVCMOS15 DRIVE=8;
IO_LOC  "ddr3_cke_o" K6;
IO_PORT "ddr3_cke_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_cs_n_o" P4;
IO_PORT "ddr3_cs_n_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_ras_n_o" L5;
IO_PORT "ddr3_ras_n_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_cas_n_o" L4;
IO_PORT "ddr3_cas_n_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_we_n_o" M5;
IO_PORT "ddr3_we_n_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_odt_o" M2;
IO_PORT "ddr3_odt_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_reset_o" L6;
IO_PORT "ddr3_reset_o" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_ba_o[0]" P5;
IO_PORT "ddr3_ba_o[0]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_ba_o[1]" P2;
IO_PORT "ddr3_ba_o[1]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_ba_o[2]" M6;
IO_PORT "ddr3_ba_o[2]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[0]" M1;
IO_PORT "ddr3_a_o[0]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[1]" K2;
IO_PORT "ddr3_a_o[1]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[2]" G2;
IO_PORT "ddr3_a_o[2]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[3]" J4;
IO_PORT "ddr3_a_o[3]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[4]" J2;
IO_PORT "ddr3_a_o[4]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[5]" H2;
IO_PORT "ddr3_a_o[5]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[6]" G3;
IO_PORT "ddr3_a_o[6]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[7]" J1;
IO_PORT "ddr3_a_o[7]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[8]" J5;
IO_PORT "ddr3_a_o[8]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[9]" H5;
IO_PORT "ddr3_a_o[9]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[10]" L1;
IO_PORT "ddr3_a_o[10]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[11]" H3;
IO_PORT "ddr3_a_o[11]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[12]" K4;
IO_PORT "ddr3_a_o[12]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[13]" K1;
IO_PORT "ddr3_a_o[13]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[14]" D1;
IO_PORT "ddr3_a_o[14]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_a_o[15]" R1;
IO_PORT "ddr3_a_o[15]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_0_dm_o[0]" AA4;
IO_PORT "ddr3_0_dm_o[0]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_0_dqs_p_io[0]" Y3;
IO_PORT "ddr3_0_dqs_p_io[0]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dm_o[1]" V7;
IO_PORT "ddr3_0_dm_o[1]" IO_TYPE=LVCMOS15;
IO_LOC  "ddr3_0_dqs_p_io[1]" V9;
IO_PORT "ddr3_0_dqs_p_io[1]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[0]" Y4;
IO_PORT "ddr3_0_dq_io[0]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[1]" AB3;
IO_PORT "ddr3_0_dq_io[1]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[2]" AA5;
IO_PORT "ddr3_0_dq_io[2]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[3]" V4;
IO_PORT "ddr3_0_dq_io[3]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[4]" AA1;
IO_PORT "ddr3_0_dq_io[4]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[5]" AB2;
IO_PORT "ddr3_0_dq_io[5]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[6]" AB5;
IO_PORT "ddr3_0_dq_io[6]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[7]" AB1;
IO_PORT "ddr3_0_dq_io[7]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[8]" AA8;
# Pulled the other way on purpose: with nothing driving the bus this
# lane must read all ones, which tells a silent part from a capture
# path that is not working.
IO_PORT "ddr3_0_dq_io[8]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_LOC  "ddr3_0_dq_io[9]" Y8;
IO_PORT "ddr3_0_dq_io[9]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[10]" AB7;
IO_PORT "ddr3_0_dq_io[10]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[11]" Y7;
IO_PORT "ddr3_0_dq_io[11]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[12]" AB8;
IO_PORT "ddr3_0_dq_io[12]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[13]" W9;
IO_PORT "ddr3_0_dq_io[13]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[14]" AB6;
IO_PORT "ddr3_0_dq_io[14]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dq_io[15]" Y9;
IO_PORT "ddr3_0_dq_io[15]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;

# The strobes' other halves, driven complementary on writes.
IO_LOC  "ddr3_0_dqs_n_io[0]" AA3;
IO_PORT "ddr3_0_dqs_n_io[0]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
IO_LOC  "ddr3_0_dqs_n_io[1]" V8;
IO_PORT "ddr3_0_dqs_n_io[1]" IO_TYPE=LVCMOS15 PULL_MODE=DOWN;
