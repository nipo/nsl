// On-board micro SD card socket.  The board carries no pull-ups of
// its own, so the pads provide the ones a bus needs; the clock is the
// only line a host never lets go of.
IO_LOC  "tf_clk_o" V15;
IO_PORT "tf_clk_o" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "tf_cmd_io" Y16;
IO_PORT "tf_cmd_io" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "tf_dat_io[0]" AA15;
IO_PORT "tf_dat_io[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "tf_dat_io[1]" AB15;
IO_PORT "tf_dat_io[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "tf_dat_io[2]" W14;
IO_PORT "tf_dat_io[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "tf_dat_io[3]" W15;
IO_PORT "tf_dat_io[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
// Card detect, which the socket grounds while a card is in.  It is
// the one pin of the socket that is not in the socket's own bank: it
// sits with the buttons, on a supply a card knows nothing about, and
// what holds it up is the pad itself.
IO_LOC  "tf_det_i" Y13;
IO_PORT "tf_det_i" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
