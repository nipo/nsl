IOBUF  PORT "sdram_casn" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sdram_rasn" SITE "A12";
IOBUF  PORT "sdram_rasn" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;

# What the part is held to, against the clock forwarded beside it.
#
# The PHY keeps one register per pin and forwards the memory clock
# half a period behind the one those registers launch on, so the part
# samples the middle of the window a pin is held for.  Nothing below
# makes that half period -- it comes out of the ODDR -- and no number
# below is a margin on its own: every pin of this bus carries the same
# PLL and pad latency, the forwarded clock included, so what these
# bound is the *spread* between the pins and the clock, and on a
# source synchronous bus the spread is the whole of the margin.
#
# CLOCK_TO_OUT ... CLKOUT PORT measures a data pad's transition
# against "sdram_clk"'s for the same launching edge, and the
# transition it measures against is the forwarded clock's falling one.
# The rising edge, which is what the part samples on, is half a period
# after it.  A pin holds its value for a whole period, so with the
# part asking tIS before that edge and tIH after it:
#
#   MAX = tCK/2 - tIS  and  MIN = tIH - tCK/2
#
# INPUT_SETUP has no CLKOUT of its own, so the read side is written
# against a clock net rather than the clock port: measured from the
# port it would carry the PLL's own output phase, which the tools pick
# with the dividers and which therefore moves with the rate, while
# what the part actually answers to is the memory clock itself.  From
# the PLL output both sides of the loop are placement and nothing
# else.
#
# The part answers tAC after the sdram_clk edge it was asked on and
# holds tOH past the next one; the fabric catches that on the falling
# edge one period later, which is what makes the eye reachable at all
# (see nsl_ext_ram/DESIGN.md sec. 11).  So, with Tco the memory clock
# net to "sdram_clk" pad delay -- 5.81 ns slow and 2.21 ns fast here,
# which a CLOCK_TO_OUT on the clock pin itself will print:
#
#   INPUT_DELAY = Tco(slow) + tAC   and   HOLD = -(Tco(fast) + tOH)
#
# INPUT_DELAY is period relative, so the read side follows the memory
# clock by itself; the CLOCK_TO_OUT pair does not, and is written here
# for the rate sdram/src/boundary.vhd asks the PLL for.
#
# tIS 1.5 ns, tIH 0.8 ns, tAC 5.4 ns and tOH 2.5 ns are the W9825G6KH
# figures this library already carries, as the defaults of
# nsl_ext_ram.simulation's sdram_model.

# The memory clock, named because nothing else names it: the tools
# cannot read a rate out of the PLL without being told what feeds it,
# and left alone they hold this domain to the rate they assume at the
# PLL's input rather than to the one boundary.vhd asks for.
FREQUENCY NET "ram_raw_s" 80 MHZ ;

# The panel and the rate measurer read this domain from the board
# clock and are read back from it, over NSL resynchronisers.  The two
# clocks come out of one PLL, so BLOCK ASYNCPATHS does not reach them:
# the tools relate them and score the crossing against a period.
#
# Cut rather than relaxed.  MULTICYCLE is the tempting form -- a
# resynchroniser wants its hold met and not its setup -- and it makes
# the tools try and fail rather than not try: the hold is then asked
# of an edge two periods away and the report fills with "cannot fix
# hold timing violation".
BLOCK PATH FROM CLKNET "clk_c_1" TO CLKNET "ram_raw_s" ;
BLOCK PATH FROM CLKNET "ram_raw_s" TO CLKNET "clk_c_1" ;

# Command setup and hold at the part, tIS 1.5 ns / tIH 0.8 ns, at 80 MHz.
CLOCK_TO_OUT PORT "sdram_cke" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
CLOCK_TO_OUT PORT "sdram_csn" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
CLOCK_TO_OUT PORT "sdram_rasn" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
CLOCK_TO_OUT PORT "sdram_casn" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
CLOCK_TO_OUT PORT "sdram_wen" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
# Address setup and hold at the part, same tIS / tIH.
CLOCK_TO_OUT PORT "sdram_ba[*]" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
CLOCK_TO_OUT PORT "sdram_a[*]" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
# Mask setup and hold at the part, same tIS / tIH.
CLOCK_TO_OUT PORT "sdram_dqm[*]" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
# Write data setup and hold at the part, same tIS / tIH.  This scores
# the tri-state control beside the data, which has to reach the pad in
# the same window or the part samples a bus nobody is driving.
CLOCK_TO_OUT PORT "sdram_dq[*]" MAX 4.75 ns MIN -5.45 ns CLKPORT "clk" CLKOUT PORT "sdram_clk" ;
# Read data: access time tAC 5.4 ns, output hold tOH 2.5 ns.
INPUT_SETUP PORT "sdram_dq[*]" INPUT_DELAY 11.2 ns HOLD -4.71 ns CLKNET "ram_raw_s" SS ;
